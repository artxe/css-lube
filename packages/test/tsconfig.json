{
	"compilerOptions": {
		"allowJs": true,
		"allowSyntheticDefaultImports": true,
		"checkJs": true,
		"exactOptionalPropertyTypes": true,
		"lib": [ "ESNext", "DOM", "DOM.Iterable" ],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"noEmit": true,
		"noPropertyAccessFromIndexSignature": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "esnext",
		"types": [ "node" ]
	}
}
