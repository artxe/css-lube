{
	"compilerOptions": {
		"checkJs": true,
		"exactOptionalPropertyTypes": true,
		"lib": [ "ESNext" ],
		"module": "commonjs",
		"noEmit": true,
		"noPropertyAccessFromIndexSignature": true,
		"rootDir": "src",
		"skipLibCheck": true,
		"strict": true,
		"target": "esnext",
		"types": [ "node", "vscode" ]
	},
	"include": [ "src/**/*.js" ]
}